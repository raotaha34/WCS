@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
    ViewData["ActivePage"] = "Settings";
}

<div class="page-header">
    <h1><i class="bi bi-gear me-2"></i>Settings</h1>
</div>

<div class="row g-4">
    <!-- Profile Settings -->
    <div class="col-lg-6">
        <div class="card-custom p-4">
            <h5 class="fw-bold mb-4">Profile Settings</h5>
            <form asp-action="UpdateProfile" asp-controller="AdminSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="text-center mb-4">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=6366F1&color=fff&size=128" alt="Profile" style="width:100px;height:100px;border-radius:50%;">
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-custom">Change Photo</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="FullName" class="form-control form-control-custom" value="Admin User">
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="Email" class="form-control form-control-custom" value="admin@smartcommunity.com">
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone</label>
                    <input type="tel" name="Phone" class="form-control form-control-custom" value="0300-1234567">
                </div>
                <button type="submit" class="btn btn-primary-custom w-100">Save Changes</button>
            </form>
        </div>
    </div>

    <!-- Security Settings -->
    <div class="col-lg-6">
        <div class="card-custom p-4">
            <h5 class="fw-bold mb-4">Change Password</h5>
            <form asp-action="UpdatePassword" asp-controller="AdminSettings" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Current Password</label>
                    <input type="password" name="CurrentPassword" class="form-control form-control-custom" placeholder="Enter current password">
                </div>
                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input type="password" name="NewPassword" class="form-control form-control-custom" placeholder="Enter new password">
                </div>
                <div class="mb-4">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" name="ConfirmPassword" class="form-control form-control-custom" placeholder="Confirm new password">
                </div>
                <button type="submit" class="btn btn-primary-custom w-100">Update Password</button>
            </form>
        </div>

        <div class="card-custom p-4 mt-4">
            <h5 class="fw-bold mb-4">System Preferences</h5>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <p class="fw-medium mb-0">Email Notifications</p>
                    <small class="text-muted">Receive email alerts for new issues</small>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" checked style="width:44px;height:22px;">
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <p class="fw-medium mb-0">SMS Alerts</p>
                    <small class="text-muted">Receive SMS for urgent matters</small>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" style="width:44px;height:22px;">
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="fw-medium mb-0">Dark Mode</p>
                    <small class="text-muted">Toggle dark theme</small>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input dark-mode-toggle" type="checkbox" style="width:44px;height:22px;cursor:pointer;">
                </div>
            </div>
        </div>
    </div>
</div>
