@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="page-header">
    <h1><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>
</div>

<!-- Admin Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:linear-gradient(135deg,#EEF2FF 0%,#E0E7FF 100%);color:#6366F1;box-shadow:0 4px 12px rgba(99,102,241,0.15);"><i class="bi bi-people"></i></div>
            <h3>@ViewData["ResidentCount"]</h3>
            <p>Total Residents</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:linear-gradient(135deg,#FEF2F2 0%,#FEE2E2 100%);color:#EF4444;box-shadow:0 4px 12px rgba(239,68,68,0.15);"><i class="bi bi-exclamation-circle"></i></div>
            <h3>3</h3>
            <p>Open Issues</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:linear-gradient(135deg,#FFEDD5 0%,#FED7AA 100%);color:#F97316;box-shadow:0 4px 12px rgba(249,115,22,0.15);"><i class="bi bi-hourglass-split"></i></div>
            <h3>3</h3>
            <p>In Progress</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="admin-stat-card">
            <div class="admin-stat-icon" style="background:linear-gradient(135deg,#ECFDF5 0%,#D1FAE5 100%);color:#10B981;box-shadow:0 4px 12px rgba(16,185,129,0.15);"><i class="bi bi-check-circle"></i></div>
            <h3>4</h3>
            <p>Resolved</p>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="chart-container">
            <h5>Issue Status Distribution</h5>
            <div style="height:280px;">
                <canvas id="issuesPieChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="chart-container">
            <h5>Monthly Complaints</h5>
            <div style="height:280px;">
                <canvas id="complaintsBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Complaints -->
<div class="card-custom p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Recent Complaints</h5>
        <a href="@Url.Action("Index", "AdminIssues")" class="btn btn-sm btn-outline-custom">View All</a>
    </div>
    <div class="table-responsive">
        <table class="table table-custom mb-0" id="adminIssuesTable">
            <thead>
                <tr><th>Issue</th><th>Resident</th><th>Category</th><th>Status</th><th>Date</th><th>Action</th></tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/chart.js" asp-append-version="true"></script>
}
