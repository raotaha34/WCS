@model List<wcm.ViewModels.ResidentViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Residents Management";
    ViewData["ActivePage"] = "Residents";



}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<div class="page-header">
    <h1><i class="bi bi-people me-2"></i>Residents Management</h1>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addResidentModal"><i class="bi bi-plus-lg me-1"></i>Add Resident</button>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom mb-0" id="residentsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Unit</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FullName</td>
                            <td>@item.UnitNumber</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-warning"
                                        onclick='openEditModal(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.FullName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.UnitNumber)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Email)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.PhoneNumber)), @item.IsActive.ToString().ToLower())'>
                                    Edit
                                </button>
                                <form asp-action="DeleteResident" asp-controller="Admin" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No residents found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Resident Modal --> 
<div class="modal fade" id="addResidentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add New Resident</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateResident" asp-controller="Admin" method="post" id="addResidentForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" class="form-control form-control-custom" placeholder="Enter name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Unit Number</label>
                        <input type="text" name="UnitNumber" class="form-control form-control-custom" placeholder="e.g., A-101">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control form-control-custom" placeholder="email@example.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control form-control-custom" placeholder="Enter password">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="tel" name="PhoneNumber" class="form-control form-control-custom" placeholder="0300-1234567">
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-custom">Add Resident</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<!-- Edit Resident Modal -->
<div class="modal fade" id="editResidentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Resident</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form asp-action="EditResident" asp-controller="Admin" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Id" id="editId" />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="FullName" id="editFullName" class="form-control form-control-custom">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Unit Number</label>
                        <input type="text" name="UnitNumber" id="editUnitNumber" class="form-control form-control-custom">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" id="editEmail" class="form-control form-control-custom">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="PhoneNumber" id="editPhone" class="form-control form-control-custom">
                    </div>


                    <div class="mb-3 form-check">
                        <input type="checkbox"
                               name="IsActive"
                               value="true"
                               class="form-check-input"
                               id="editIsActive">
                        <label class="form-check-label">Active</label>
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-custom">Update Resident</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script>


    function openEditModal(id, name, unit, email, phone, isActive) {

        document.getElementById("editId").value = id;
        document.getElementById("editFullName").value = name ?? "";
        document.getElementById("editUnitNumber").value = unit ?? "";
        document.getElementById("editEmail").value = email || "";
        document.getElementById("editPhone").value = phone || "";
        document.getElementById("editIsActive").checked = (isActive === true || isActive === "true");

        var modal = new bootstrap.Modal(document.getElementById('editResidentModal'));
        modal.show();

    }


    
    document.getElementById('editResidentModal').addEventListener('hidden.bs.modal', function () {
        this.querySelector("form").reset();
    });

   
</script>