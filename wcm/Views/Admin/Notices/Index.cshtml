@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Notices";
    ViewData["ActivePage"] = "Notices";
}

<div class="page-header">
    <h1><i class="bi bi-megaphone me-2"></i>Manage Notices</h1>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addNoticeModal"><i class="bi bi-plus-lg me-1"></i>Create Notice</button>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom mb-0" id="adminNoticesTable">
            <thead>
                <tr><th>Title</th><th>Category</th><th>Date</th><th>Action</th></tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Add Notice Modal -->
<div class="modal fade" id="addNoticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create New Notice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" asp-controller="AdminNotices" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="Title" class="form-control form-control-custom" placeholder="Notice title">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-select">
                            <option>Maintenance</option>
                            <option>Community</option>
                            <option>Security</option>
                            <option>Rules</option>
                            <option>Facilities</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control form-control-custom" rows="3" placeholder="Notice content..."></textarea>
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-custom">Create Notice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
