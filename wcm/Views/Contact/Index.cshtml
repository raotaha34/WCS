@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
}

<div class="page-header">
    <h1><i class="bi bi-envelope me-2"></i>Contact Us</h1>
</div>

<div class="row g-4">
    <!-- Contact Form -->
    <div class="col-lg-7">
        <div class="card-custom p-4 p-md-5">
            <h5 class="fw-bold mb-4">Send us a Message</h5>
            <form asp-action="Index" asp-controller="Contact" method="post" id="contactForm">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Your Name</label>
                        <input type="text" name="Name" id="contactName" class="form-control form-control-custom" placeholder="John Doe">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium">Email Address</label>
                        <input type="email" name="Email" id="contactEmail" class="form-control form-control-custom" placeholder="john@example.com">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Subject</label>
                    <input type="text" name="Subject" id="contactSubject" class="form-control form-control-custom" placeholder="How can we help you?">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-medium">Message</label>
                    <textarea name="Message" id="contactMessage" class="form-control form-control-custom" rows="5" placeholder="Write your message here..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary-custom w-100 py-2">
                    <i class="bi bi-send me-2"></i>Send Message
                </button>
            </form>
        </div>
    </div>

    <!-- Contact Info -->
    <div class="col-lg-5">
        <div class="contact-info-card">
            <h5 class="fw-bold mb-4">Get in Touch</h5>
            <div class="contact-info-item">
                <i class="bi bi-telephone"></i>
                <div>
                    <h5>Phone</h5>
                    <p>+92 300 1234567<br>+92 301 7654321</p>
                </div>
            </div>
            <div class="contact-info-item">
                <i class="bi bi-envelope"></i>
                <div>
                    <h5>Email</h5>
                    <p>info@smartcommunity.com<br>support@smartcommunity.com</p>
                </div>
            </div>
            <div class="contact-info-item">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <h5>Address</h5>
                    <p>Block 7, Gulshan-e-Iqbal<br>Karachi, Pakistan</p>
                </div>
            </div>
            <div class="contact-info-item">
                <i class="bi bi-clock"></i>
                <div>
                    <h5>Office Hours</h5>
                    <p>Mon - Fri: 9:00 AM - 6:00 PM<br>Sat: 10:00 AM - 2:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</div>
