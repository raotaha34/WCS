<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Smart Community Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="sidebar-overlay"></div>

    <div class="sidebar admin-sidebar" id="sidebar">
        <div class="sidebar-logo"><i class="bi bi-shield-lock"></i> Admin Panel</div>
        <ul class="sidebar-menu">
            <li><a href="@Url.Action("Index","AdminDashboard")" class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
            <li><a href="@Url.Action("Resident","Admin")" class="@(ViewData["ActivePage"]?.ToString() == "Resident" ? "active" : "")"><i class="bi bi-people"></i> Residents</a></li>
            <li><a href="@Url.Action("Index","AdminIssues")" class="@(ViewData["ActivePage"]?.ToString() == "Issues" ? "active" : "")"><i class="bi bi-exclamation-triangle"></i> Issues</a></li>
            <li><a href="@Url.Action("Index","AdminNotices")" class="@(ViewData["ActivePage"]?.ToString() == "Notices" ? "active" : "")"><i class="bi bi-megaphone"></i> Notices</a></li>
            <li><a href="@Url.Action("Index","AdminEvents")" class="@(ViewData["ActivePage"]?.ToString() == "Events" ? "active" : "")"><i class="bi bi-calendar-event"></i> Events</a></li>
            <li><a href="@Url.Action("Index","AdminSettings")" class="@(ViewData["ActivePage"]?.ToString() == "Settings" ? "active" : "")"><i class="bi bi-gear"></i> Settings</a></li>
            <li><a href="@Url.Action("Logout","Account")" class="logout-link"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <button class="hamburger-btn"><i class="bi bi-list"></i></button>
                <div class="search-bar"><i class="bi bi-search"></i><input type="text" placeholder="Search..."></div>
            </div>
            <div class="nav-icons">
                <div class="icon-btn notification-btn">
                    <i class="bi bi-bell"></i><span class="badge">5</span>
                </div>
                <div class="user-profile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=6366F1&color=fff" alt="Admin">
                    <div>
                        <div class="name">Admin User</div>
                        <div class="role">Administrator</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>

        <div class="footer-custom">
            <p class="mb-0">&copy; Smart Community. All rights reserved.</p>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/validation.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
