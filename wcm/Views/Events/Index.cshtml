@{
    ViewData["Title"] = "Events";
    ViewData["ActivePage"] = "Events";
}

<div class="page-header">
    <h1><i class="bi bi-calendar-event me-2"></i>Community Events</h1>
</div>

<div class="card-custom p-4 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <h5 class="fw-bold mb-2">Upcoming Events</h5>
            <p class="text-muted mb-0" style="font-size:0.9rem;">Join our community events and stay connected with your neighbors.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <span class="badge bg-primary" style="font-size:0.85rem;padding:8px 16px;"><i class="bi bi-calendar3 me-1"></i> 6 Events</span>
        </div>
    </div>
</div>

<div class="row" id="eventsContainer"></div>
