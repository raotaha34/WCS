@model wcm.ViewModels.ProfileUpdateVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
    ViewData["ActivePage"] = "Settings";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="page-header">
    <h1><i class="bi bi-gear me-2"></i>Settings</h1>
</div>

<div class="row g-4">

    <!-- PROFILE -->
    <div class="col-lg-6">
        <div class="card-custom p-4">

            <h5 class="fw-bold mb-4">Profile Settings</h5>

            <form asp-action="UpdateProfile" asp-controller="AdminSettings" method="post">
                @Html.AntiForgeryToken()

                <div class="text-center mb-4">
                    <img src="https://ui-avatars.com/api/?name=@(Model?.FullName ?? "User")"
                         style="width:100px;height:100px;border-radius:50%;" />
                </div>

                <div class="mb-3">
                    <label>Full Name</label>
                    <input name="FullName"
                           class="form-control"
                           value="@(Model!.FullName ?? "")" />
                </div>

                <div class="mb-3">
                    <label>Email</label>
                    <input name="Email"
                           class="form-control"
                           value="@(Model.Email ?? "")" />
                </div>

                <div class="mb-3">
                    <label>Phone</label>
                    <input name="Phone"
                           class="form-control"
                           value="@(Model.Phone ?? "")" />
                </div>

                <button class="btn btn-primary w-100">
                    Save Changes
                </button>
            </form>

        </div>
    </div>

    <!-- PASSWORD -->
    <div class="col-lg-6">
        <div class="card-custom p-4">

            <h5 class="fw-bold mb-4">Change Password</h5>

            <form asp-action="UpdatePassword" method="post">
                @Html.AntiForgeryToken()

                <input name="CurrentPassword" type="password" class="form-control mb-3" placeholder="Current Password" />
                <input name="NewPassword" type="password" class="form-control mb-3" placeholder="New Password" />
                <input name="ConfirmPassword" type="password" class="form-control mb-3" placeholder="Confirm Password" />

                <button class="btn btn-primary w-100">
                    Update Password
                </button>
            </form>

        </div>
    </div>

</div>