@model wcm.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Smart Community</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true">
</head>
<body>

    <div class="login-wrapper">
        <!-- Left Banner -->
        <div class="login-banner">
            <div style="position:absolute;inset:0;z-index:0;">
                <div style="position:absolute;top:10%;left:10%;width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,0.3);animation:fadeIn 2s ease infinite;"></div>
                <div style="position:absolute;top:30%;left:25%;width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,0.2);animation:fadeIn 3s ease 0.5s infinite;"></div>
                <div style="position:absolute;top:60%;left:15%;width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,0.25);animation:fadeIn 2.5s ease 1s infinite;"></div>
                <div style="position:absolute;top:20%;right:20%;width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,0.2);animation:fadeIn 2s ease 1.5s infinite;"></div>
                <div style="position:absolute;top:70%;right:30%;width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,0.3);animation:fadeIn 3s ease 0.8s infinite;"></div>
                <div style="position:absolute;top:45%;left:45%;width:2px;height:2px;border-radius:50%;background:rgba(255,255,255,0.15);animation:fadeIn 2.5s ease 0.3s infinite;"></div>
            </div>
            <i class="bi bi-buildings" style="font-size:4.5rem;margin-bottom:24px;z-index:1;filter:drop-shadow(0 8px 24px rgba(99,102,241,0.4));color:#A5B4FC;"></i>
            <h1>Smart Community</h1>
            <p>Connect, communicate, and manage your community with ease. A modern platform for residents and administration.</p>
        </div>

        <!-- Right Form -->
        <div class="login-form-area">
            <div class="login-form-box">
                <div class="logo-text"><i class="bi bi-buildings me-2" style="color:var(--secondary)"></i>Smart Community</div>
                <p class="logo-sub">Sign in to your account to continue</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-medium" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-muted);font-weight:600;">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0" style="border-radius:var(--radius-sm) 0 0 var(--radius-sm);border-color:var(--border);padding-left:16px;"><i class="bi bi-envelope" style="color:var(--accent);"></i></span>
                            <input type="email" asp-for="Email" id="email" class="form-control form-control-custom border-start-0 ps-0" style="border-radius:0 var(--radius-sm) var(--radius-sm) 0;border-color:var(--border);" placeholder="name@example.com">
                            @* <input type="email" name="Email" id="email" class="form-control form-control-custom border-start-0 ps-0" style="border-radius:0 var(--radius-sm) var(--radius-sm) 0;border-color:var(--border);" placeholder="name@example.com"> *@
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.6px;color:var(--text-muted);font-weight:600;">Password</label>
                        <div class="password-field">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0" style="border-radius:var(--radius-sm) 0 0 var(--radius-sm);border-color:var(--border);padding-left:16px;"><i class="bi bi-lock" style="color:var(--accent);"></i></span>
                                <input type="password" asp-for="Password" id="password" class="form-control form-control-custom border-start-0 border-end-0 ps-0" style="border-color:var(--border);" placeholder="Enter your password">
                                @* <input type="password" name="Password" id="password" class="form-control form-control-custom border-start-0 border-end-0 ps-0" style="border-color:var(--border);" placeholder="Enter your password"> *@
                            </div>
                            <button type="button" class="toggle-password" style="right:16px;"><i class="bi bi-eye-slash"></i></button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="remember">
                            @* <input class="form-check-input" type="checkbox" name="RememberMe" id="remember" style="cursor:pointer;border-color:var(--border);"> *@
                            <label class="form-check-label" for="remember" style="font-size:0.85rem;cursor:pointer;color:var(--text-muted);">Remember me</label>
                        </div>
                        <a href="#" style="font-size:0.85rem;color:var(--accent);font-weight:600;">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-3 mb-3" style="border-radius:var(--radius-sm);font-size:1rem;letter-spacing:0.3px;">Sign In</button>

                    <div class="text-center">
                        <p style="font-size:0.85rem;color:var(--text-muted);">Don't have an account? <a href="#" style="color:var(--accent);font-weight:600;">Register here</a></p>
                    </div>

                    <div class="d-flex align-items-center gap-3 my-4">
                        <div style="flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--border));"></div>
                        <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;font-weight:600;">Admin</span>
                        <div style="flex:1;height:1px;background:linear-gradient(90deg,var(--border),transparent);"></div>
                    </div>

                    @* <div class="text-center" display="hidden"> *@
                    <div class="text-center" style="display:none;">
                        <a href="@Url.Action("Login","Account")" class="btn btn-outline-custom w-100 py-2" style="font-size:0.9rem;border-radius:var(--radius-sm);">
                            <i class="bi bi-shield-lock me-2"></i>Go to Admin Panel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/validation.js" asp-append-version="true"></script>
</body>
</html>
