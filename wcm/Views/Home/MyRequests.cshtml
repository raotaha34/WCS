@model List<wcm.ViewModels.MyRequestVM>
@{
    ViewData["Title"] = "My Requests";
    ViewData["ActivePage"] = "MyRequests";
}

<div class="page-header">
    <h1><i class="bi bi-list-check me-2"></i>My Requests</h1>
    <a href="@Url.Action("ReportIssue","Home")" class="btn btn-primary-custom"><i class="bi bi-plus-lg me-1"></i>New Request</a>
</div>

<div class="card-custom p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="requestSearch" class="form-control border-start-0" placeholder="Search requests...">
            </div>
        </div>
        <div class="col-md-3">
            <select id="requestFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Pending">Open Issue</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
            </select>
        </div>
    </div>
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom mb-0" id="requestsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Issue</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>

                            <td>@item.Title</td>

                            <td>
                                <span class="badge bg-info">
                                    @item.Category
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "OpenIssue")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Open Issue
                                    </span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                }
                                else if (item.Status == "Resolved")
                                {
                                    <span class="badge bg-success">
                                        Resolved
                                    </span>
                                }
                            </td>
                            <td>
                                @item.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <button class="btn btn-sm btn-outline-primary">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            No requests found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initSearchFilter('requestsTable', 'requestSearch', 'requestFilter');
        });
    </script>
}
